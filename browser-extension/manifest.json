{
  "manifest_version": 3,
  "name": "YTM Lyrics Bridge",
  "version": "0.1.0",
  "description": "Reports YouTube Music playback state to the YTM Lyrics VS Code extension over loopback.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ]
}
